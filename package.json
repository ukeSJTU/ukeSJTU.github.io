{
	"name": "astro-cactus",
	"type": "module",
	"version": "7.2.0",
	"private": false,
	"scripts": {
		"postinstall": "npm rebuild sharp --force",
		"prepare": "simple-git-hooks",
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"check": "astro check && biome check",
		"lint": "biome check --write",
		"format": "prettier -w . --cache"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.2",
		"@astrojs/mdx": "5.0.6",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@expressive-code/core": "0.44.1",
		"@fujocoded/expressive-code-caption": "^0.0.3",
		"@fujocoded/expressive-code-output": "^0.1.0",
		"@pagefind/component-ui": "^1.5.2",
		"@tailwindcss/vite": "4.3.3",
		"@xt0rted/expressive-code-file-icons": "^1.0.0",
		"astro": "6.3.3",
		"astro-expressive-code": "^0.44.1",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^8.0.2",
		"expressive-code-color-chips": "^0.2.0",
		"expressive-code-fullscreen": "^1.1.0",
		"hastscript": "^9.0.0",
		"mdast-util-directive": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.29.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.6",
		"@iconify-json/mdi": "^1.2.2",
		"@pagefind/default-ui": "^1.5.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^25.8.0",
		"autoprefixer": "^10.5.4",
		"lint-staged": "^17.2.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"reading-time": "^1.5.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"sharp": "^0.35.3"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged",
		"pre-push": "pnpm check"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc,css}": ["biome check --write --no-errors-on-unmatched"],
		"*.{astro,md,mdx,yml,yaml}": ["prettier --write --cache --ignore-unknown"]
	}
}
